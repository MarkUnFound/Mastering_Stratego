import pygame
import time
import random
import csv
from stratego import Board, auto_setup, side_name, FILES
from bot_logic import BotLogic

pygame.init()
TILE_SIZE = 60
BOARD_SIZE = 10
BORDER_SIZE = 30
BOARD_WIDTH = TILE_SIZE * BOARD_SIZE
HISTORY_WIDTH = 300
TOTAL_BOARD_WIDTH = BOARD_WIDTH + BORDER_SIZE * 2
WIDTH, HEIGHT = TOTAL_BOARD_WIDTH + HISTORY_WIDTH, 750
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Stratego Visual")

# Colors
WHITE = (240, 240, 240)
BLACK = (30, 30, 30)
BLUE = (50, 150, 255)
RED = (220, 50, 50)
GREY = (180, 180, 180)
DARK_GREY = (100, 100, 100)
GREEN = (60, 180, 60)

font = pygame.font.SysFont(None, 28)

# Game state
current_player = 1
selected = None
running = True
game_state = "menu"
message = "Welcome to Stratego!"
human_side = 1
vs_bot = False
bot_logic = None
move_history = []


# Setup board
board = Board()
auto_setup(board, 1)
auto_setup(board, 2)

# --- Helper functions ---
def draw_text(text, x, y, size=28, color=BLACK, center=True):
    f = pygame.font.SysFont(None, size)
    surf = f.render(text, True, color)
    rect = surf.get_rect(center=(x, y)) if center else surf.get_rect(topleft=(x, y))
    screen.blit(surf, rect)
    return rect

def draw_button(text, x, y, w, h, action=None):
    mouse = pygame.mouse.get_pos()
    click = pygame.mouse.get_pressed()
    rect = pygame.Rect(x, y, w, h)
    is_hovered = rect.collidepoint(mouse)
    
    # Special highlight for the Start Game button
    if action == "start" and game_state == "setup":
        color = GREEN if is_hovered else BLUE
    else:
        color = GREY if is_hovered else DARK_GREY

    if is_hovered and click[0] and action:
        return action
        
    pygame.draw.rect(screen, color, rect)
    draw_text(text, x + w // 2, y + h // 2, 32, WHITE)
    return None

def draw_board(bot_move=None):
    """Draw board with algebraic notation and pieces."""
    # Draw labels
    for i in range(BOARD_SIZE):
        # File labels (A-J)
        draw_text(FILES[i], BORDER_SIZE + i * TILE_SIZE + TILE_SIZE // 2, BORDER_SIZE // 2, 24, BLACK)
        # Rank labels (1-10)
        draw_text(str(i + 1), BORDER_SIZE // 2, BORDER_SIZE + i * TILE_SIZE + TILE_SIZE // 2, 24, BLACK)

    for r in range(BOARD_SIZE):
        for c in range(BOARD_SIZE):
            rect = pygame.Rect(BORDER_SIZE + c*TILE_SIZE, BORDER_SIZE + r*TILE_SIZE, TILE_SIZE, TILE_SIZE)
            if board.is_lake(r, c):
                pygame.draw.rect(screen, BLUE, rect)
                continue

            pygame.draw.rect(screen, GREY, rect, 1)
            piece = board.get((r, c))
            if not piece:
                continue

            color = RED if piece.owner == 1 else BLACK

            visible = (piece.owner == human_side) or piece.revealed or (game_state == "setup")

            if selected == (r, c):
                pygame.draw.rect(screen, GREEN, rect, 3)

            pygame.draw.circle(screen, color, rect.center, TILE_SIZE // 3)
            text = font.render(str(piece.short()) if visible else "??", True, WHITE)
            text_rect = text.get_rect(center=rect.center)
            screen.blit(text, text_rect)

def get_square_from_mouse(pos):
    x, y = pos
    if x < BORDER_SIZE or y < BORDER_SIZE or x > BOARD_WIDTH + BORDER_SIZE or y > BOARD_SIZE * TILE_SIZE + BORDER_SIZE:
        return None
    c = (x - BORDER_SIZE) // TILE_SIZE
    r = (y - BORDER_SIZE) // TILE_SIZE
    if 0 <= r < BOARD_SIZE and 0 <= c < BOARD_SIZE:
        return (r, c)
    return None

def draw_move_history():
    """Draw the move history panel."""
    history_area = pygame.Rect(TOTAL_BOARD_WIDTH, 0, HISTORY_WIDTH, HEIGHT)
    screen.fill(DARK_GREY, history_area)
    draw_text("Move History", TOTAL_BOARD_WIDTH + HISTORY_WIDTH // 2, 30, 32, WHITE)
    
    y_offset = 70
    for i, move_text in enumerate(reversed(move_history)):
        if y_offset > HEIGHT - 50:
            break
        draw_text(f"{len(move_history) - i}. {move_text}", TOTAL_BOARD_WIDTH + 10, y_offset, 24, WHITE, center=False)
        y_offset += 30



# --- Bot Logic ---
def choose_bot_move(board, owner):
    if bot_logic:
        return bot_logic.choose_move(board, owner)
    return None  # Should not be reached if bot_logic is initialized

# --- Bot Turn ---
def bot_turn():
    global message, current_player, game_state
    draw_move_history()
    #draw_text("Bot is thinking...", WIDTH//2, HEIGHT-50, 28, WHITE)
    time.sleep(0.8)

    move = choose_bot_move(board, current_player)
    if not move:
        message = f"{side_name(current_player)} (Bot) has no moves! {side_name(3 - current_player)} wins!"
        game_state = "menu"
        return

    src, dst = move
    # Format the move into notation
    move_notation = f"Enemy: {chr(ord('A')+src[1])}{src[0]+1}-{chr(ord('A')+dst[1])}{dst[0]+1}"
    move_history.append(move_notation)
    msg, winner = board.move_and_resolve(src, dst)
    message = msg


    # No board to draw, but we can log the move
    pass
    time.sleep(0.5)

    if winner:
        message = f"{side_name(winner)} wins!"
        game_state = "menu"
    else:
        current_player = 3 - current_player

# --- Main loop ---
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if game_state == "play" and event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                game_state = "pause"


        if game_state == "setup" and event.type == pygame.MOUSEBUTTONDOWN:
            sq = get_square_from_mouse(event.pos)
            if not sq:
                continue

            if selected is None:
                piece = board.get(sq)
                if piece and piece.owner == human_side:
                    selected = sq
            else:
                if sq[0] >= BOARD_SIZE - 4:
                    p1 = board.get(selected)
                    p2 = board.get(sq)
                    board.set(selected, p2)
                    board.set(sq, p1)
                    selected = None
                else:
                    message = "Invalid move. Place on your side."
                    selected = None

        elif game_state == "play" and (not vs_bot or current_player == human_side):
            if event.type == pygame.MOUSEBUTTONDOWN:
                sq = get_square_from_mouse(event.pos)
                if not sq:
                    continue
                if selected is None:
                    piece = board.get(sq)
                    if piece and piece.owner == current_player and piece.is_movable():
                        selected = sq
                else:
                    src, dst = selected, sq
                    if dst in board.legal_moves_from(src):
                        piece = board.get(src)
                        move_notation = f"{piece.name()}: {chr(ord('A')+src[1])}{src[0]+1}-{chr(ord('A')+dst[1])}{dst[0]+1}"
                        move_history.append(move_notation)
                        msg, winner = board.move_and_resolve(src, dst)
                        message = msg
                        if winner:
                            game_state = "menu"
                        current_player = 3 - current_player
                        selected = None
                    else:
                        selected = None

    # --- Screen Rendering ---
    screen.fill(WHITE)

    if game_state == "menu":
        draw_text("STRATEGO", (BOARD_WIDTH + BORDER_SIZE * 2) // 2, 100, 72, BLUE)
        if draw_button(text="Play vs Bot", x=TOTAL_BOARD_WIDTH // 2 - 100, y=200, w=200, h=60, action="bot") == "bot":
            board = Board()
            vs_bot = True
            human_side = 1
            current_player = 1
            auto_setup(board, human_side) # Pre-place pieces
            auto_setup(board, 3 - human_side) # Pre-place bot pieces for now
            bot_logic = BotLogic('d:\\Research\\Python Stratego Game\\agent2_final.pth')
            game_state = "setup"
            message = "Arrange your pieces. Click to select and move."
        if draw_button(text="2-Player Mode", x=TOTAL_BOARD_WIDTH // 2 - 100, y=280, w=200, h=60, action="2p") == "2p":
            board = Board()
            auto_setup(board, 1)
            auto_setup(board, 2)
            vs_bot = False
            human_side = None
            current_player = 1
            message = "Player 1's turn"
            game_state = "play"
        if draw_button(text="Download History", x=TOTAL_BOARD_WIDTH // 2 - 100, y=360, w=200, h=60, action="download") == "download":
            with open('stratego_history.csv', 'w', newline='') as f:
                writer = csv.writer(f)
                writer.writerow(['Move Number', 'Notation'])
                for i, move in enumerate(move_history):
                    writer.writerow([i + 1, move])
            message = "History saved to stratego_history.csv"
        if draw_button(text="Quit", x=TOTAL_BOARD_WIDTH // 2 - 100, y=440, w=200, h=60, action="quit") == "quit":
            running = False

    elif game_state == "setup":
        draw_board()
        draw_text("Setup Phase: Rearrange your pieces", TOTAL_BOARD_WIDTH // 2, BOARD_SIZE * TILE_SIZE + BORDER_SIZE + 20, 28, BLACK)
        
        action = draw_button(text="Start Game", x=TOTAL_BOARD_WIDTH // 2 - 100, y=BOARD_SIZE * TILE_SIZE + BORDER_SIZE + 50, w=200, h=50, action="start")
        if action == "start":
            # Clear the bot's side and do a final, random setup for it
            for r in range(4):
                for c in range(10):
                    board.set((r, c), None)
            auto_setup(board, 3 - human_side)
            game_state = "play"
            message = "Player 1's turn"

    elif game_state == "play":
        draw_board()
        draw_move_history()
        if vs_bot and current_player != human_side:
            bot_turn()
        # Redraw message bar after bot turn
        msg_bar = pygame.Rect(0, BOARD_SIZE * TILE_SIZE + BORDER_SIZE * 2, TOTAL_BOARD_WIDTH, 100)
        pygame.draw.rect(screen, DARK_GREY, msg_bar)
        draw_text(message, TOTAL_BOARD_WIDTH // 2, BOARD_SIZE * TILE_SIZE + BORDER_SIZE * 2 + 50, 28, WHITE)

    elif game_state == "pause":
        draw_text("Paused", TOTAL_BOARD_WIDTH // 2, 120, 72, BLUE)
        if draw_button(text="Resume", x=TOTAL_BOARD_WIDTH // 2 - 100, y=200, w=200, h=60, action="resume") == "resume":
            game_state = "play"
        if draw_button(text="Quit to Menu", x=TOTAL_BOARD_WIDTH // 2 - 100, y=300, w=200, h=60, action="menu") == "menu":
            game_state = "menu"
        if draw_button(text="Exit", x=TOTAL_BOARD_WIDTH // 2 - 100, y=400, w=200, h=60, action="exit") == "exit":
            running = False

    pygame.display.flip()

pygame.quit()
